{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doannguyentrong.github.io/kindle-primitive-catalog/schema/manifest.schema.json",
  "title": "Package manifest (manifest.json inside a store zip)",
  "type": "object",
  "required": ["schema", "id", "dir", "version", "arch", "firmware", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
    "dir": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,2}(-p[0-9]+)?$" },
    "arch": { "enum": ["armhf", "armel"] },
    "firmware": {
      "type": "object", "required": ["min"], "additionalProperties": false,
      "properties": { "min": { "type": "string" }, "max": { "type": ["string", "null"] } }
    },
    "requires": { "type": "object", "additionalProperties": { "type": "string" } },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "string",
        "not": { "pattern": "(^/)|(^\\.\\.?/)|(/\\.\\./)|(/\\.\\.$)|(\\\\)" },
        "pattern": "^(documents/|extensions/[a-z0-9][a-z0-9-]*/|(?!(documents|extensions|system|fonts|screensaver|koreader)/)[a-z0-9][a-z0-9-]*/)"
      }
    },
    "hooks": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["hooks/post-install.sh", "hooks/pre-uninstall.sh"] },
      "if": { "contains": { "const": "hooks/post-install.sh" } },
      "then": { "contains": { "const": "hooks/pre-uninstall.sh" } }
    }
  }
}
