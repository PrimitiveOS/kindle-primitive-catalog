    "shots/1.png",
    "shots/2.png"
  ],
  "changes": {
    "network": true,
    "stops_kindle_ui": false,
    "starts_at_boot": false,
    "root_filesystem": false,
    "hooks": false,
    "notes": "Connects to the web when you open a page."
  },
