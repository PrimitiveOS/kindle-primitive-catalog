{
  "schema": 1,
  "id": "primitive-launcher",
  "dir": "launcher",
  "name": "Primitive Launcher",
  "subtitle": "Your PrimitiveOS home screen",
  "developer": {
    "name": "Primitive AI",
    "url": "https://github.com/PrimitiveOS"
  },
  "categories": [
    "system"
  ],
  "description": "Open your app grid and preview separate Home, Sleep, and Startup wallpapers before applying them. Manage battery, display, Wi-Fi, storage, and time from Settings. View installed app versions and uninstall apps offline from Settings › Apps. Use the Kindle UI tile to return to Amazon’s interface.",
  "repo": "https://github.com/PrimitiveOS/kindle-primitive-launcher",
  "licence": "PolyForm-Noncommercial-1.0.0",
  "source": "hosted",
  "icon": "icon.png",
  "screenshots": [
    "shots/1.png",
    "shots/2.png",
    "shots/3.png"
  ],
  "changes": {
    "network": true,
    "stops_kindle_ui": true,
    "starts_at_boot": true,
    "root_filesystem": true,
    "hooks": false,
    "notes": "Writes its boot job to /etc/upstart while the root filesystem is writable, only when it changes."
  },
