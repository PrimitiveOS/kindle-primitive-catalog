{
  "schema": 1,
  "id": "primitive-reader",
  "dir": "reader",
  "name": "Reader",
  "subtitle": "Read books and documents offline",
  "developer": {
    "name": "Primitive AI"
  },
  "categories": [
    "reading"
  ],
  "repo": "https://github.com/PrimitiveOS/kindle-primitive-reader",
  "licence": "PolyForm-Noncommercial-1.0.0",
  "description": "Read EPUB, DRM-free AZW3 and MOBI, PDFs, comics and documents from the Kindle Documents folder. Browse chapters, follow links, adjust type and margins, and keep bookmarks, highlights and notes. Read extracted EPUB folders with their illustrations.\n\nUse physical buttons or touch, track book or chapter progress in the footer, and choose actions for reading gestures. Straighten scanned pages and recognize text offline with the included English OCR model.\n\nLocal dictionaries work offline. You can also select a passage and choose Wikipedia or translation. Reader shows the provider and text before sending an online request.\n\nPreview footnotes on the reading page, search a selected passage and move between dictionary definitions. Open JPEG 2000 images and comic pages.",
  "source": "hosted",
  "icon": "icon.png",
  "screenshots": [
    "shots/1.png",
    "shots/2.png",
    "shots/3.png",
    "shots/4.png",
    "shots/5.png"
  ],
  "changes": {
    "network": true,
    "stops_kindle_ui": false,
    "starts_at_boot": false,
    "root_filesystem": false,
    "hooks": false,
    "notes": "Saves progress and annotations in Reader’s data folder. Wikipedia and translation send text only after you choose the online action."
  },
